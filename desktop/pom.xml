<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.teggr</groupId>
        <artifactId>java-game</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>desktop</artifactId>
    <dependencies>
        <dependency>
            <groupId>io.github.teggr</groupId>
            <artifactId>game</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>me.friwi</groupId>
            <artifactId>jcefmaven</artifactId>
            <version>${jcefmaven.version}</version>
        </dependency>
    </dependencies>
    <build>
        <finalName>java-game</finalName>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>io.github.jarrunner</groupId>
                    <artifactId>jr-maven-plugin</artifactId>
                    <version>1.3.0</version>
                    <executions>
                        <execution>
                            <phase>package</phase>
                            <goals><goal>exe</goal></goals>
                        </execution>
                    </executions>
                    <configuration>
                        <name>java-game</name>
                        <javaVersion>25</javaVersion>
                        <jvmMode>exe</jvmMode>
                        <aot>false</aot>
                        <productName>Skybound</productName>
                        <fileDescription>Skybound Java Game</fileDescription>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-assembly-plugin</artifactId>
                    <version>3.7.1</version>
                    <executions>
                        <execution>
                            <phase>package</phase>
                            <goals><goal>single</goal></goals>
                            <configuration>
                                <descriptors>
                                    <descriptor>src/assembly/${distribution.platform}.xml</descriptor>
                                </descriptors>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>io.github.teggr.javagame.DesktopApp</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>windows</id>
            <properties><distribution.platform>windows</distribution.platform></properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.github.jarrunner</groupId>
                        <artifactId>jr-maven-plugin</artifactId>
                        <configuration>
                            <platforms><platform>windows</platform></platforms>
                            <jarPath>java-game.jar</jarPath>
                            <vmArgs><arg>--enable-native-access=ALL-UNNAMED</arg></vmArgs>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>macos</id>
            <properties><distribution.platform>macos</distribution.platform></properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>io.github.jarrunner</groupId>
                        <artifactId>jr-maven-plugin</artifactId>
                        <configuration>
                            <platforms><platform>macos</platform></platforms>
                            <macosForms><form>app</form></macosForms>
                            <macosArchitecture>universal</macosArchitecture>
                            <macosDisplayName>Skybound</macosDisplayName>
                            <macosBundleId>io.github.teggr.javagame</macosBundleId>
                            <jarPath>../../../java-game.jar</jarPath>
                            <vmArgs>
                                <arg>--enable-native-access=ALL-UNNAMED</arg>
                                <arg>--add-opens=java.desktop/sun.awt=ALL-UNNAMED</arg>
                                <arg>--add-opens=java.desktop/sun.lwawt=ALL-UNNAMED</arg>
                                <arg>--add-opens=java.desktop/sun.lwawt.macosx=ALL-UNNAMED</arg>
                            </vmArgs>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
